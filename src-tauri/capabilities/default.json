{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/tags/tauri-v2.1.1/crates/tauri-utils/schemas/acl/capability.schema.json",
  "identifier": "default",
  "description": "Default permissions for Switchboard",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "clipboard-manager:allow-read-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "dialog:allow-save",
    "dialog:allow-open",
    "log:default",
    "notification:default",
    "core:window:allow-request-user-attention",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
