{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/tags/tauri-v2.1.1/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Switchboard",
  "version": "0.6.2",
  "identifier": "com.switchboard.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1620",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Switchboard",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": "v1Compatible",
    "resources": ["resources/mcp/switchboard-mcp.cjs"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5M0E3NkVDQjRGOEUyN0EKUldSNjR2aTA3SFk2Q1g1bHhJNEV1ekJBVEhBK0xkMlczTXBnQmd0ZXNsKzZwZTd2NGYzQlhMZ1UK",
      "endpoints": [
        "https://github.com/ericmitchellchan/switchboard/releases/latest/download/latest.json"
      ]
    }
  }
}
