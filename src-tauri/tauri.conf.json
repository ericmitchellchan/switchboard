{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/tags/tauri-v2.1.1/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Switchboard",
  "version": "0.1.0",
  "identifier": "com.switchboard.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Switchboard",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
