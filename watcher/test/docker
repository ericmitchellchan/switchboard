#!/bin/sh
# A fake `docker` for lib/dockerWatch.test.ts: answers exactly the calls
# docker-watch.sh makes, from the fixtures beside this file (mounted at /fake).
# `stop` records the name in /state/stopped instead of stopping anything — and
# fails for `no-such`, so the "stop failed" path is distinguishable. `inspect`
# with the compose-project format answers from the inspect fixture.
case "$1" in
  ps)
    case "$2" in
      -aq) cat /fake/ids ;;
      -q) cat /fake/running_ids ;;
    esac ;;
  inspect)
    if [ "$2" = "-f" ]; then
      # docker inspect -f '<compose project>' <name>: the 7th field of the fixture row whose name matches
      awk -F'|' -v n="/$4" '$2 == n { print $7; found = 1 } END { if (!found) exit 1 }' /fake/inspect | sed 's/<no value>//'
    else
      cat /fake/inspect
    fi ;;
  stats) cat /fake/stats ;;
  exec) f="/fake/netdev_$2"; if [ -f "$f" ]; then cat "$f"; else exit 1; fi ;;
  stop) if [ "$2" = "no-such" ]; then echo "Error: No such container: no-such" >&2; exit 1; fi; echo "$2" >>/state/stopped ;;
  *) echo "fake docker: unexpected call: $*" >&2; exit 2 ;;
esac
